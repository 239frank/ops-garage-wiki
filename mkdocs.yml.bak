site_name: The Ops Garage
site_description: Field notes, home lab builds, cyber operations, automation, and lessons learned from the garage.
site_url: https://ops.casadegarcia.tv

theme:
  name: material
  features:
    - navigation.tabs
    - navigation.sections
    - navigation.top
    - search.highlight
    - search.suggest
    - content.code.copy
  palette:
    - scheme: slate
      primary: black
      accent: blue

plugins:
  - search

markdown_extensions:
  - admonition
  - toc:
      permalink: true
  - tables
  - fenced_code

nav:
  - Start Here:
      - Home: index.md
      - About Me: start/about.md
      - Current Focus: start/current-focus.md
  - Cyber / GRC:
      - Overview: cyber/index.md
      - NIST 800-53 Notes: cyber/nist-800-53.md
      - RMF / ATO Notes: cyber/rmf-ato.md
      - CMMC Notes: cyber/cmmc.md
  - Home Lab:
      - Overview: homelab/index.md
      - Unraid Server: homelab/unraid.md
      - Network Diagram: homelab/network.md
      - Docker Stack: homelab/docker.md
      - Monitoring: homelab/monitoring.md
  - Automation:
      - Overview: automation/index.md
      - n8n Workflows: automation/n8n.md
      - Alerting: automation/alerting.md
  - Projects:
      - Overview: projects/index.md
      - IR Tracker: projects/ir-tracker.md
      - GRC LLM: projects/grc-llm.md
      - Personal Wiki: projects/personal-wiki.md
  - Field Notes:
      - Overview: notes/index.md
      - Useful Commands: notes/useful-commands.md
      - Troubleshooting Logs: notes/troubleshooting.md
  - Career:
      - Overview: career/index.md
      - Portfolio: career/portfolio.md
      - Leadership Notes: career/leadership.md
